create database jogos;

use jogos;

CREATE TABLE jogo (
    id_jogo INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(100) NOT NULL,
    desenvolvedora VARCHAR(100) NOT NULL,
    genero_id INT,
    sinopse TEXT,
    FOREIGN KEY (genero_id) REFERENCES generos(id_genero)
);

